{
  "name": "simple-pilot-logbook-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply simple-pilot-logbook --local",
    "migrate:remote": "wrangler d1 migrations apply simple-pilot-logbook --remote"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.141.0"
  }
}
