# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Environment files
.env
.env.*
!.env.example

# SQLite / local runtime data
backend/logbook.db
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm

# Logs and temporary files
*.log
*.tmp
*.bak

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Cloudflare worker
worker/node_modules/
worker/.wrangler/
worker/.dev.vars

# Local agent runtime data
agent/*.db
agent/*.db-*
agent/.env
agent/*.log
agent/*.log.*

# Node agent build output and dependencies
agent/node_modules/
agent/dist/

# Generated Windows service files (the .xml.template is committed)
agent/service/*.exe
agent/service/*.log
agent/service/SimplePilotLogbook.xml
agent/service/*.out.log
agent/service/*.err.log
agent/service/*.wrapper.log
