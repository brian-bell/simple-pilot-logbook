# Copy this file to agent/.env and fill in the two required values.
# agent/.env is gitignored — never commit it.

# URL printed by `npx wrangler deploy` (no trailing slash). For local dev: http://localhost:8787
WORKER_URL=https://simple-pilot-logbook.<your-account>.workers.dev

# Must match the Worker secret set with:  npx wrangler secret put AGENT_TOKEN
AGENT_TOKEN=

# Optional tuning (defaults shown)
#HEARTBEAT_SECONDS=10
#POSITION_SECONDS=10
#BATCH_SIZE=20
#OUTBOX_PATH=C:\path\to\outbox.db
#LOG_PATH=C:\path\to\agent.log

# Optional: force a TCP SimConnect endpoint instead of auto-detection
# (auto-detection tries SimConnect.cfg, the named pipe, the registry port and
# finally the static IPv4 port in %APPDATA%\Microsoft Flight Simulator 2024\SimConnect.xml).
#SIMCONNECT_HOST=127.0.0.1
#SIMCONNECT_PORT=500
