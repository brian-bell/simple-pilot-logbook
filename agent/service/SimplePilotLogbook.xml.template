<!--
  WinSW service definition for the Simple Pilot Logbook agent.
  install_service.ps1 renders this template into SimplePilotLogbook.xml next to
  SimplePilotLogbook.exe (a renamed WinSW-x64.exe), replacing the placeholders.
-->
<service>
  <id>SimplePilotLogbook</id>
  <name>Simple Pilot Logbook</name>
  <description>Detects MSFS flights via SimConnect and uploads them to the Simple Pilot Logbook Cloudflare Worker.</description>
  <executable>__NODE_EXE__</executable>
  <arguments>--disable-warning=ExperimentalWarning dist/main.js</arguments>
  <workingdirectory>__AGENT_DIR__</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <logpath>__AGENT_DIR__\service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>2</keepFiles>
  </log>
</service>
